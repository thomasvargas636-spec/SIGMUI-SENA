//- Reservation card component
//- Included from pages/reservations/cancelReservationView.pug
//- Expects:
//- reservation {
//-   id,
//-   status,
//-   zone,
//-   date,
//-   duration,
//-   price
//- }
//- Optional:
//- buttonLabel

article.reservationCard

  .reservationCard__header

    span.reservationCard__code= reservation.id

    span.reservationCard__status(class=`reservationCard__status--${reservation.status}`)
      = reservation.status

  .reservationCard__body

    dl.reservationCard__information

      dt.reservationCard__label Zona

      dd.reservationCard__value= reservation.zone

      dt.reservationCard__label Fecha

      dd.reservationCard__value= reservation.date

      dt.reservationCard__label Duración

      dd.reservationCard__value #{reservation.duration} · #{reservation.price}

  .reservationCard__footer

    button.reservationCard__button(
      type="button"
      data-id=reservation.id
    )

      span.reservationCard__buttonIcon
        include ../../icons/trashIcon.pug

      span.reservationCard__buttonLabel= buttonLabel || 'Cancelar reserva'