div(class="w-full p-8 rounded-[16px] bg-[#141B27] border border-[#1E2A3A] shadow-2xl")
  // Encabezado
  div(class="mb-6")
    h1(class="font-syne text-[20px] font-extrabold text-[#E8EDF5] tracking-tight mb-1.5") Crear cuenta
    p(class="text-[13px] text-[#5A6A7E] leading-normal") Regístrate para acceder a todas las funciones de la plataforma

  // Formulario
  form#registerForm(class="space-y-4" action="/api/auth/register" method="POST")
    // Nombres y Apellidos
    div(class="grid grid-cols-2 gap-3")
      div
        label(class="block text-[11px] font-semibold text-[#5A6A7E] uppercase tracking-wider mb-1.5" for="firstname") Nombre
        input#firstname(
          class="w-full px-3.5 py-2.5 bg-[#0F1520] border border-[#1E2A3A] rounded-lg text-[13.5px] text-[#E8EDF5] placeholder-[#5A6A7E] focus:outline-none focus:border-[#1A6FD4] transition-colors"
          type="text" 
          name="firstname" 
          placeholder="Camilo" 
          required
        )
      div
        label(class="block text-[11px] font-semibold text-[#5A6A7E] uppercase tracking-wider mb-1.5" for="lastname") Apellido
        input#lastname(
          class="w-full px-3.5 py-2.5 bg-[#0F1520] border border-[#1E2A3A] rounded-lg text-[13.5px] text-[#E8EDF5] placeholder-[#5A6A7E] focus:outline-none focus:border-[#1A6FD4] transition-colors"
          type="text" 
          name="lastname" 
          placeholder="García" 
          required
        )

    // Correo Electrónico
    div
      label(class="block text-[11px] font-semibold text-[#5A6A7E] uppercase tracking-wider mb-1.5" for="email") Correo electrónico
      input#email(
        class="w-full px-3.5 py-2.5 bg-[#0F1520] border border-[#1E2A3A] rounded-lg text-[13.5px] text-[#E8EDF5] placeholder-[#5A6A7E] focus:outline-none focus:border-[#1A6FD4] transition-colors"
        type="email" 
        name="email" 
        placeholder="camilo@gmail.com" 
        required
      )

    // Contraseña
    div
      label(class="block text-[11px] font-semibold text-[#5A6A7E] uppercase tracking-wider mb-1.5" for="password") Contraseña
      input#password(
        class="w-full px-3.5 py-2.5 bg-[#0F1520] border border-[#1E2A3A] rounded-lg text-[13.5px] text-[#E8EDF5] placeholder-[#5A6A7E] focus:outline-none focus:border-[#1A6FD4] transition-colors"
        type="password" 
        name="password" 
        placeholder="********" 
        required
      )

    // Requisitos de Contraseña
    div(class="bg-[#0F1520] border border-[#1E2A3A] rounded-lg p-3.5 my-4")
      div(class="text-[11px] font-semibold text-[#5A6A7E] mb-2") Requisitos para tu contraseña
      div(class="flex items-center gap-2 text-[12px] text-[#5A6A7E] mb-1")
        span(class="w-1.5 h-1.5 rounded-full bg-[#5A6A7E] shrink-0")
        | Entre 8 y 12 caracteres
      div(class="flex items-center gap-2 text-[12px] text-[#5A6A7E] mb-1")
        span(class="w-1.5 h-1.5 rounded-full bg-[#5A6A7E] shrink-0")
        | Al menos una letra mayúscula
      div(class="flex items-center gap-2 text-[12px] text-[#5A6A7E] mb-1")
        span(class="w-1.5 h-1.5 rounded-full bg-[#5A6A7E] shrink-0")
        | Al menos un carácter especial
      div(class="flex items-center gap-2 text-[12px] text-[#5A6A7E]")
        span(class="w-1.5 h-1.5 rounded-full bg-[#5A6A7E] shrink-0")
        | Debe ser alfanumérica

    // Confirmar Contraseña
    div
      label(class="block text-[11px] font-semibold text-[#5A6A7E] uppercase tracking-wider mb-1.5" for="confirmPassword") Confirmar contraseña
      input#confirmPassword(
        class="w-full px-3.5 py-2.5 bg-[#0F1520] border border-[#1E2A3A] rounded-lg text-[13.5px] text-[#E8EDF5] placeholder-[#5A6A7E] focus:outline-none focus:border-[#1A6FD4] transition-colors"
        type="password" 
        name="confirmPassword" 
        placeholder="********" 
        required
      )

    // Separador
    div(class="h-[1px] bg-[#1E2A3A] my-5")

    // Botón
    button#btn-register(
      class="w-full py-3 bg-gradient-to-r from-[#1A6FD4] to-[#3DBE6C] rounded-lg text-white text-[14px] font-medium transition-opacity hover:opacity-90 shadow-lg shadow-[#1A6FD4]/20 cursor-pointer"
      type="submit"
    ) Crear cuenta

  // Link Login
  div(class="mt-4 text-center text-[13px] text-[#5A6A7E]")
    | ¿Ya tienes una cuenta? 
    a(class="text-[#1A6FD4] font-medium hover:underline ml-1" href="/auth/login") Iniciar sesión