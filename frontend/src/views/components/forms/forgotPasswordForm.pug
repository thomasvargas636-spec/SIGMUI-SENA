form#forgotPasswordForm(action="/auth/forgot-password" method="POST" style="display: flex; flex-direction: column; gap: 18px;")
  div(style="display: flex; flex-direction: column; gap: 8px;")
    label(for="email" style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: #5A6A7E; letter-spacing: 0.8px;") Correo electrónico
    input#email(
      type="email" 
      name="email" 
      placeholder="usuario@ejemplo.com"
      required
      style="width: 100%; padding: 12px; background-color: #0F1520; border: 1px solid #1E2A3A; border-radius: 8px; color: #E8EDF5; font-size: 14px; outline: none;"
    )
    #email-error.error

  div(style="height: 1px; background-color: #1E2A3A; margin: 4px 0;")

  button.btn-primary(
    type="submit"
    style="width: 100%; padding: 12px; background: linear-gradient(135deg, #1A6FD4, #3DBE6C); border: none; border-radius: 8px; color: white; font-weight: 600; font-size: 14px; cursor: pointer;"
  ) Enviar enlace

  a.forgot-link(
    href="/auth/login"
    style="font-size: 11px; color: #1A6FD4; text-decoration: none; font-weight: 500; display: flex; justify-content: center; margin-top: 8px;"
  ) ← Volver al inicio de sesión