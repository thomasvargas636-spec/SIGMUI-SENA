form#resetForm(action="/auth/reset-password" method="POST" style="display: flex; flex-direction: column; gap: 1rem;")
    div.field(style="display: flex; flex-direction: column; gap: 6px;")
        label(for="new-password" style="font-size: 11px; font-weight: 500; letter-spacing: 0.08em; color: #8b95a5; text-transform: uppercase;") Nueva contraseña
        input(type="password" id="new-password" name="password" placeholder="••••••••" required style="background: #1e2535; border: 1px solid #2a3245; border-radius: 10px; padding: 12px 16px; font-size: 14px; color: #ffffff; font-family: 'DM Sans', sans-serif; outline: none; width: 100%;")
        div.error#new-password-error(style="font-size: 12px; color: #ef4444; display: none;")

    div.field(style="display: flex; flex-direction: column; gap: 6px;")
        label(for="confirm-password" style="font-size: 11px; font-weight: 500; letter-spacing: 0.08em; color: #8b95a5; text-transform: uppercase;") Confirmar contraseña
        input(type="password" id="confirm-password" name="confirmPassword" placeholder="••••••••" required style="background: #1e2535; border: 1px solid #2a3245; border-radius: 10px; padding: 12px 16px; font-size: 14px; color: #ffffff; font-family: 'DM Sans', sans-serif; outline: none; width: 100%;")
        div.error#confirm-password-error(style="font-size: 12px; color: #ef4444; display: none;")

    div.divider(style="height: 1px; background: #2a3245;")

    button.btn-primary(type="submit" style="width: 100%; padding: 14px; background: linear-gradient(to right, #3b82f6, #22c55e); border: none; border-radius: 10px; font-size: 15px; font-weight: 500; color: #ffffff; font-family: 'DM Sans', sans-serif; cursor: pointer; text-align: center;") Establecer contraseña
    p#success-message.success(style="font-size: 14px; color: #22c55e; text-align: center; display: none;")