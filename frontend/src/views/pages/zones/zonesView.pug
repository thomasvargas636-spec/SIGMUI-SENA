extends ../../layouts/admin.pug

block content
  link(rel="stylesheet", href="/css/pages/zones.css")
  
  .flex.items-center.justify-between.mb-8
    h1.font-heading.text-xl.font-bold.text-gray-50 Zonas de Parqueo
    span.px-3.py-1.rounded-full.text-xs.font-medium.bg-secondary-500.bg-opacity-20.text-secondary-400.border.border-secondary-500.border-opacity-30 4 zonas registradas

  .mb-4
    .text-xs.font-semibold.tracking-wider.uppercase.text-gray-500.mb-4 Zonas disponibles
    .flex.flex-col.md.flex-row.md.items-start.justify-between.gap-4
      div
        h2.font-heading.text-2xl.font-extrabold.text-gray-50 Zonas Disponibles
        p.text-sm.text-gray-400.mt-1 Consulta disponibilidad en tiempo real y reserva tu cupo
      button#filter-btn.px-5.py-2.5.rounded-lg.border.border-gray-700.text-gray-300.text-sm.font-medium.transition-colors.hover.bg-gray-800(class="hover:text-gray-50")
        | 🔍 Filtrar zonas

  .grid.grid-cols-1.gap-6(class="xl:grid-cols-[1fr_400px]")
    //- Map Component
    .bg-gray-900.border.border-gray-800.rounded-xl.overflow-hidden
      .relative.h-[400px].bg-[#0A1628].map-placeholder
        .absolute.inset-0.map-grid
        .absolute.h-2.bg-primary-500.bg-opacity-15.left-0.right-0.top-[30%]
        .absolute.h-2.bg-primary-500.bg-opacity-15.left-0.right-0.top-[60%]
        .absolute.w-2.bg-primary-500.bg-opacity-15.top-0.bottom-0.left-[25%]
        .absolute.w-2.bg-primary-500.bg-opacity-15.top-0.bottom-0.left-[65%]
        
        //- Pins will be generated by JS
      
      .flex.flex-wrap.gap-4.p-4.border-t.border-gray-800.bg-gray-950
        .flex.items-center.gap-2.text-xs.text-gray-400
          .w-2.5.h-2.5.rounded-full.bg-secondary-500
          | Disponible
        .flex.items-center.gap-2.text-xs.text-gray-400
          .w-2.5.h-2.5.rounded-full.bg-warning
          | Casi llena
        .flex.items-center.gap-2.text-xs.text-gray-400
          .w-2.5.h-2.5.rounded-full.bg-error
          | Sin cupos
        .flex.items-center.gap-2.text-xs.text-gray-400
          .w-2.5.h-2.5.rounded-full.bg-primary-500
          | Seleccionada

    //- List Component
    .flex.flex-col
      .bg-gray-900.border.border-gray-800.rounded-t-xl.p-4.flex.items-center.justify-between
        h3.font-heading.text-sm.font-bold.text-gray-50 Zonas registradas
        span.zones-status-text.text-xs.text-gray-400 3 disponibles · 1 llena
      
      .border.border-gray-800.border-t-0.rounded-b-xl.overflow-hidden.zones-list
        //- List items generated by JS

      //- Detail Panel (Hidden by default, updated by JS)
      .zone-detail-card.hidden.bg-gray-900.border.border-primary-500.rounded-xl.p-5.mt-4

  script(src="/js/pages/zones.js")
