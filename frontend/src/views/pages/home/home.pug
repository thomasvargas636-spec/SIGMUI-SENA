extends ../../layouts/admin.pug

block content
  .mb-8
    h1.text-2xl.font-heading.font-bold.text-gray-50 Dashboard
    p.text-gray-400.mt-1 Bienvenido al panel de administración de Parkalia.

  .grid.grid-cols-1(class="md:grid-cols-3 gap-6 mb-8")
    .bg-gray-900.border.border-gray-800.rounded-xl.p-6
      .flex.items-center.justify-between.mb-4
        h3.text-gray-400.font-semibold Zonas Activas
        span.text-primary-400.text-xl 🅿️
      p.text-3xl.font-bold.text-gray-50 12
      
    .bg-gray-900.border.border-gray-800.rounded-xl.p-6
      .flex.items-center.justify-between.mb-4
        h3.text-gray-400.font-semibold Vehículos hoy
        span.text-secondary-400.text-xl 🚗
      p.text-3xl.font-bold.text-gray-50 148
      
    .bg-gray-900.border.border-gray-800.rounded-xl.p-6
      .flex.items-center.justify-between.mb-4
        h3.text-gray-400.font-semibold Reservas
        span.text-warning.text-xl 📅
      p.text-3xl.font-bold.text-gray-50 24

  .bg-gray-900.border.border-gray-800.rounded-xl.p-6
    h2.text-xl.font-heading.font-bold.text-gray-50.mb-4 Actividad reciente
    .text-center.py-12
      p.text-gray-400 Aún no hay datos para mostrar.
