extends ../../layouts/auth.pug

block content
    div.screen(style="min-height: 100vh; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 2rem;")
        
        // Logo Centrado
        div.logo(style="display: flex; align-items: center; gap: 10px; margin-bottom: 2rem;")
            img.logo-img(src="/img/parkalia.png" alt="logo" style="height: 36px;")

        // Card Principal
        div.card(style="background: #161b25; border-radius: 16px; padding: 2rem; width: 100%; max-width: 400px; display: flex; flex-direction: column; gap: 1.25rem;")
            
            div.card-header(style="display: flex; flex-direction: column; gap: 8px;")
                h1.card-title(style="font-family: 'Syne', sans-serif; font-size: 28px; font-weight: 800; color: #ffffff; line-height: 1.2;") Nueva Contraseña
                p.card-subtitle(style="font-size: 14px; color: #8b95a5; line-height: 1.6;") Establece una nueva contraseña para tu cuenta

            // Alerta de Requisitos
            div.alert-info(style="background: #1a2535; border: 1px solid #22c55e33; border-radius: 10px; padding: 10px 14px; font-size: 12px; color: #22c55e; line-height: 1.6;")
                | La contraseña debe tener 
                strong máximo 16 caracteres
                | , al menos una 
                strong mayúscula 
                | y ser 
                strong alfanumérica
                | .

            // Formulario incluido
            include ../../components/forms/newPasswordForm.pug