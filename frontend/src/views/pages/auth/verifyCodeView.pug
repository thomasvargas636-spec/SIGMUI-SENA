extends ../../layouts/auth.pug

block content
    div.screen(style="min-height: 100vh; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;")
        
        // Logo Centrado
        div.logo(style="margin-bottom: 24px; text-align: center;")
            img.logo-img(src="/img/parkalia.png" alt="logo" style="height: 40px; margin: 0 auto;")

        // Card Principal
        div.card(style="width: 100%; max-width: 400px; background-color: #141B27; border: 1px solid #1E2A3A; border-radius: 16px; padding: 32px; box-shadow: 0 20px 30px rgba(0,0,0,0.4);")
            
            div.card-header(style="margin-bottom: 24px;")
                h1.card-title(style="font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; color: #E8EDF5; margin: 0 0 8px 0;") Correo enviado
                p.card-subtitle(style="font-family: 'DM Sans', sans-serif; font-size: 13px; color: #5A6A7E; margin: 0; line-height: 1.5;") Hemos enviado un código a tu correo electrónico para restablecer tu contraseña.

            // Alerta de Información
            div.alert.alert-info(style="background-color: rgba(61, 190, 108, 0.08); border: 1px solid rgba(61, 190, 108, 0.2); color: #3DBE6C; padding: 16px; border-radius: 12px; font-size: 14px; line-height: 1.5; margin: 20px 0;")
                | El código expirará en 
                strong 15 minutos
                | . Si no lo ves, revisa tu carpeta de spam.

            // Inclusión del formulario
            include ../../components/forms/verifyCodeForm.pug

            div.divider(style="height: 1px; background-color: #1E2A3A; margin: 20px 0;")
            
            // Enlace de retorno
            a.forgot-link(href="/auth/login" style="font-size: 12px; color: #1A6FD4; text-decoration: none; font-weight: 500; display: flex; justify-content: center;") ← Volver al inicio de sesión