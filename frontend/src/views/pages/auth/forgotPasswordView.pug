extends ../../layouts/auth.pug

block content
  div(style="min-height: 100vh; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; background: radial-gradient(ellipse at 15% 50%, rgba(26, 111, 212, 0.08), transparent 60%), radial-gradient(ellipse at 85% 50%, rgba(61, 190, 108, 0.06), transparent 60%), #080C10; padding: 20px;")
    
    // Logo Centrado
    div(style="margin-bottom: 24px; text-align: center;")
      img(src="/img/parkalia.png" alt="logo" style="height: 40px; margin: 0 auto;")

    // Card Principal Fija
    div(style="width: 100%; max-width: 400px; background-color: #141B27; border: 1px solid #1E2A3A; border-radius: 16px; padding: 32px; box-shadow: 0 20px 30px rgba(0, 0, 0, 0.4);")
      div(style="margin-bottom: 24px;")
        h1(style="font-family: 'Syne', sans-serif; font-size: 22px; font-weight: 800; color: #E8EDF5; margin: 0 0 4px 0;") Olvidaste tu contraseña
        p(style="font-family: 'DM Sans', sans-serif; font-size: 13px; color: #5A6A7E; margin: 0;") Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña

      include ../../components/forms/forgotPasswordForm.pug