//- Minimal layout for authentication pages (login, register, password reset)
//- No navbar/sidebar — just a centered card on a full-height background
//- Expects a `title` local (string)

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title ? `${title} · Parkalia` : "Parkalia"
    link(rel="stylesheet" href="/css/output.css")

  body.min-h-screen.flex.items-center.justify-center.bg-gray-950.font-body
    .w-full.max-w-md.p-8
      block content

    script(type="module" src="/js/main.js")
