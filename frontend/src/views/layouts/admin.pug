//- Base layout for all admin panel pages
//- Extended by every page under views/pages/
//- Expects locals: `title` (string), `user` ({ name, role, avatarUrl }), `currentRoute` (string)

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= title ? `${title} · Parkalia` : "Parkalia"
    link(rel="stylesheet" href="/css/output.css")

  body.bg-gray-950.text-gray-50.font-body.flex.flex-col.min-h-screen
    include ../components/navbar/navbarGlobal.pug

    .flex.flex-1.overflow-hidden
      include ../components/sidebar/principalSidebar.pug

      main.flex-1.p-6.overflow-y-auto.bg-gray-900
        block content

    script(type="module" src="/js/main.js")
    script(src="/js/pages/vehicles.js")